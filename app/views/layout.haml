!!!
%html{lang: 'en'}
  %head
    %meta{charset: 'utf-8'}
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}
    %meta{:name => "viewport", :content => "width=device-width, initial-scale=1"}
    %meta{name: 'description', content: 'Guardian Low Data - fast, low-data Guardian headlines.'}
    %meta{name: 'theme-color', content: '#052962'}
    %meta{name: 'mobile-web-app-capable', content: 'yes'}
    %meta{name: 'apple-mobile-web-app-capable', content: 'yes'}
    %meta{name: 'apple-mobile-web-app-status-bar-style', content: 'default'}
    %meta{name: 'apple-mobile-web-app-title', content: 'Guardian Low Data'}

    %title Guardian Low Data

    %link{rel: 'manifest', href: '/manifest.webmanifest'}
    %link{rel: 'icon', type: 'image/png', sizes: '192x192', href: '/icons/icon-192.png'}
    %link{rel: 'icon', type: 'image/png', sizes: '512x512', href: '/icons/icon-512.png'}
    %link{rel: 'apple-touch-icon', href: '/icons/apple-touch-icon-180.png'}
    %link{rel: 'stylesheet', type: "text/css", href: "/app.css" }
  %body
    %header
      %h1
        %a.home-link{href: '/'}
          Guardian Low Data
    != yield
    %script{src: '/app.js', defer: true}
